{
  "schema_version": "1.0",
  "objective": "Explore broadly across Internet opportunity domains while exploiting verified capabilities and preserving economic truth.",
  "allocation": {
    "exploit": 0.50,
    "adjacent": 0.30,
    "experimental": 0.20
  },
  "domains": {
    "code_automation": 0.20,
    "data_csv": 0.20,
    "b2b_research": 0.20,
    "writing_documentation": 0.10,
    "web_landing_pages": 0.10,
    "translation": 0.08,
    "open_source_bounties": 0.07,
    "digital_products": 0.05
  },
  "decision_states": ["execute_now", "prepare_then_gate", "capability_build", "reject"],
  "pivot_rules": {
    "rejected_without_candidate": 30,
    "source_results_without_eligible": 50,
    "proposals_without_reply": 5,
    "replies_without_conversion": 3,
    "first_verified_payment": "expand_similar_searches"
  },
  "hard_rules": {
    "exclude_charcoal": true,
    "require_fresh_open_status": true,
    "require_payment_path": true,
    "require_acceptance_criteria": true,
    "require_legal_policy_pass": true,
    "max_first_mission_effort_hours": 8,
    "min_capability_fit": 0.70,
    "max_human_actions_before_start": 1,
    "never_count_forecast_as_pipeline_or_revenue": true
  }
}
