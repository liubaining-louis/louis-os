{
  "schema_version": "1.0",
  "sources": [
    {
      "id": "github_bounties",
      "category": "code_bounty",
      "access_mode": "official_api",
      "discovery_status": "enabled",
      "official_url": "https://api.github.com",
      "credential_env": "GITHUB_TOKEN",
      "account_required_for_submission": true,
      "terms_acceptance_required": false,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "pull_request_or_issue",
      "notes": "Existing final-safe capability-first GitHub path."
    },
    {
      "id": "opire_public_bounties",
      "category": "code_bounty",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://app.opire.dev/home",
      "allowed_hosts": ["app.opire.dev", "github.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "github_pull_request_and_opire_claim",
      "notes": "Read-only discovery accepts only platform-displayed available rewards; canonical GitHub issue state is verified before routing; payout uses Stripe and may require truthful setup."
    },
    {
      "id": "algora_public_bounties",
      "category": "code_bounty",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://algora.io",
      "allowed_hosts": ["algora.io", "github.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "github_pull_request_and_algora_claim",
      "notes": "Read-only reviewed organization boards; canonical GitHub issue state, excessive value, unsafe wording and crowded claims fail closed."
    },
    {
      "id": "freelancer_public_simple_jobs",
      "category": "freelance_marketplace",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://www.freelancer.com/jobs/",
      "allowed_hosts": ["www.freelancer.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "platform_proposal",
      "notes": "Cash-first discovery accepts only current remote listings with explicit platform-displayed budget ranges, positive time remaining and bounded bid counts. Average bids are not payer budget evidence. A proposal dossier is prepared before any account or terms gate."
    },
    {
      "id": "freelancer_public_software_jobs",
      "category": "freelance_marketplace",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://www.freelancer.com/jobs/website-design/",
      "allowed_hosts": ["www.freelancer.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "platform_proposal",
      "notes": "Dedicated read-only categories for website design, HTML, CSS, JavaScript, Python, API and WordPress work. The software scope guard accepts only bounded remotely deliverable work no greater than 16 hours and rejects full applications, copied sites, unbounded support, access bypass and high-risk production changes."
    },
    {
      "id": "guru_public_simple_jobs",
      "category": "freelance_marketplace",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://www.guru.com/d/jobs/",
      "allowed_hosts": ["www.guru.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "platform_quote",
      "notes": "Cash-first discovery reads public job pages only. It requires an explicit fixed or bounded hourly range, a future send-before date, low quote count, strong employer spend/payment history and remotely deliverable digital scope. Guru SafePay evidence is preserved, and a quote dossier is prepared before any account or terms gate."
    },
    {
      "id": "truelancer_public_simple_jobs",
      "category": "freelance_marketplace",
      "access_mode": "official_public_html",
      "discovery_status": "enabled",
      "official_url": "https://www.truelancer.com/freelance-jobs?page=1",
      "allowed_hosts": ["www.truelancer.com"],
      "account_required_for_submission": true,
      "terms_acceptance_required": true,
      "legal_entity_required": false,
      "kyc_possible_for_payout": true,
      "submission_mode": "platform_proposal",
      "notes": "Cash-first discovery requires a recent public listing, explicit fixed or hourly budget, estimated effort no greater than 16 hours, bounded proposal count, active detail page and credible client payment history. Platform safety evidence requires no security deposit and all payment to remain on Truelancer."
    },
    {
