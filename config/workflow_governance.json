{
  "schema_version": "1.0",
  "max_workflow_files": 150,
  "max_scheduled_workflows": 3,
  "max_scheduled_runs_per_day": 7,
  "min_schedule_interval_minutes": 60,
  "require_manual_dispatch_for_scheduled": true,
  "require_serial_execution": true,
  "execution_concurrency_group": "louis-os-single-execution",
  "policy_only_commit_marker": "[workflow-policy-only]"
}
